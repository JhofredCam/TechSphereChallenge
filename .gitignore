# LibreOffice/OpenOffice lock files — embed local username and LAN IP of whoever
# has the spreadsheet open, never useful to commit.
.~lock.*#

# Python bytecode cache
__pycache__/
*.pyc

# Local application state and secrets
.env
.env.*
!.env.example
.secrets/
secretos/
*.secret
*.secret.*
data/
data-verification/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
logs/
.pytest_cache/
.coverage
htmlcov/

# Agent-local configuration, sessions and caches
skills-lock.json
.agents/
.agent/
.agent-state/
.opencode/
.opencode.json
.opencode.jsonc
opencode.json
opencode.jsonc
*.agent.json
*.agent.local.*

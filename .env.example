# Local-only application paths. Bootstrap does not require a provider key.
APP_DATA_DIR=data
# APP_DATABASE_PATH=data/app.sqlite3
# APP_UPLOADS_DIR=data/uploads

# RAG profile and backend. The current checkout defaults to the tested FTS5 baseline.
RAG_PROFILE=challenge-local
RAG_BACKEND=fts5
RAG_SHADOW_BACKEND=none
RAG_FALLBACK_TO_FTS5=true
RAG_INDEX_VERSION=baseline-fts5-v1
RAG_CONFIG_VERSION=1
# Target profile after the migration and benchmark gates:
# RAG_PROFILE=production
# RAG_BACKEND=chroma
# EMBEDDING_PROVIDER=sentence_transformers
# RAG_INDEX_VERSION=clinical_es_recursive320_bge_v1

# Chunking. These are the canonical migration variables; APP_CHUNK_* remains documented only
# while the runtime transition is implemented.
SPLITTER_TYPE=recursive_es_v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
CHUNK_UNIT=characters
CHUNK_MIN_SIZE=80
CHUNK_MAX_SIZE=1600
CHUNK_SEPARATORS=heading,paragraph,sentence,space
CHUNK_PRESERVE_PAGE_BOUNDARIES=true
CHUNK_NORMALIZE_WHITESPACE=true
CHUNKING_VERSION=recursive_es_v2
# APP_CHUNK_SIZE=1200
# APP_CHUNK_OVERLAP=200
# APP_MAX_UPLOAD_BYTES=26214400

# Embeddings. challenge-local does not load or download a model. Staging/production must preload
# the model and set its exact revision/dimension in the index manifest.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=unset
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_TIMEOUT_MS=350

# Vector store. The active example is coherent with the tested baseline. Chroma is the production
# target and the same variables are ready for the staging/production profile above.
VECTOR_STORE_TYPE=fts5
VECTOR_STORE_MODE=embedded
VECTOR_STORE_PATH=data/chroma
VECTOR_STORE_HOST=127.0.0.1
VECTOR_STORE_PORT=8001
COLLECTION_NAME=techsphere_rag
COLLECTION_PREFIX=clinical_es
DISTANCE_METRIC=cosine
VECTOR_SPACE_VERSION=cosine-v1
VECTOR_UPSERT_BATCH_SIZE=64
VECTOR_QUERY_TIMEOUT_MS=100
VECTOR_DELETE_TIMEOUT_MS=1000
VECTOR_STORE_TLS=false
# VECTOR_STORE_AUTH_TOKEN=replace-with-a-local-secret

# Provider endpoints and independent timeouts. The current runtime keeps these defaults in code;
# the migration will move them behind the validated settings object.
GROQ_CHAT_TIMEOUT_MS=12000
GROQ_WHISPER_TIMEOUT_MS=30000
GROQ_WHISPER_URL=https://api.groq.com/openai/v1/audio/transcriptions
SQLITE_BUSY_TIMEOUT_MS=5000
# EMBEDDING_ENDPOINT=https://embedding-provider.example/v1
# EMBEDDING_API_KEY=replace-with-a-local-secret

# Retrieval and context limits.
TOP_K=5
VECTOR_TOP_K=8
VECTOR_FETCH_K=32
LEXICAL_TOP_K=8
SIMILARITY_THRESHOLD=0.35
RAG_RRF_K=60
RAG_CONTEXT_MAX_TOKENS=1800
RAG_MAX_CHUNKS_TO_PROMPT=4
RAG_QUERY_TIMEOUT_MS=500
RAG_RETRY_COUNT=0
RAG_CACHE_QUERY_TTL_SECONDS=600
RAG_CACHE_QUERY_MAX_ENTRIES=1024

# Total patient listening duration for one browser turn, in milliseconds. The effective value is
# exposed by GET /health and is independent from the Groq, Whisper and SQLite timeouts.
PATIENT_LISTEN_TIMEOUT_MS=30000

# LangChain/LangSmith tracing. Content capture is disabled by default and keys are never committed.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=replace-with-a-local-secret
LANGCHAIN_PROJECT=techsphere-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SAMPLE_RATE=0.10
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_REDACT_PII=true
LANGSMITH_TRACE_RETENTION_DAYS=7
OBSERVABILITY_ENV=local
TRACE_LATENCY_BUDGET_MS=20

# Optional Groq path for allowed Llama reasoning and Whisper STT.
# GROQ_API_KEY=replace-with-a-local-secret
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

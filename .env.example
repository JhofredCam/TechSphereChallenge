# Local-only application paths. Bootstrap does not require a provider key.
APP_DATA_DIR=data
# APP_DATABASE_PATH=data/app.sqlite3
# APP_UPLOADS_DIR=data/uploads

# Optional local ingestion tuning.
# APP_CHUNK_SIZE=1200
# APP_CHUNK_OVERLAP=200
# APP_MAX_UPLOAD_BYTES=26214400

# Planned patient listening limit for one browser turn, in milliseconds.
# Defined in specs/05_patient_listening_timeout_specification.md. It has no runtime effect until
# that spec is implemented; this file is not loaded automatically by the current checkout. It is
# separate from Groq, Whisper and SQLite.
PATIENT_LISTEN_TIMEOUT_MS=30000

# Optional Groq path for allowed Llama reasoning and Whisper STT.
# GROQ_API_KEY=replace-with-a-local-secret
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3
